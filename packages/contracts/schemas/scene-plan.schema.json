{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:novel-writer:contract:v1:ScenePlan",
  "title": "ScenePlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scene_id",
    "index",
    "purpose",
    "required_outcome",
    "required_facts",
    "forbidden_reveals",
    "active_threads",
    "target_tension",
    "target_words"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "scene_id": { "type": "string", "minLength": 1 },
    "index": { "type": "integer", "minimum": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "required_outcome": { "type": "string", "minLength": 1 },
    "required_facts": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "forbidden_reveals": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "active_threads": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "target_tension": { "type": "integer", "minimum": 1, "maximum": 10 },
    "target_words": { "type": "integer", "minimum": 1 },
    "pov": { "type": "string", "minLength": 1 },
    "location": { "type": "string", "minLength": 1 },
    "participants": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
