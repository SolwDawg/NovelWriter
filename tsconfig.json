{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "packages/contracts/generated/**/*.ts",
    "packages/contracts/src/**/*.ts",
    "packages/domain-types/src/**/*.ts",
    "apps/api/src/**/*.ts",
    "apps/api/test/**/*.ts"
  ]
}
